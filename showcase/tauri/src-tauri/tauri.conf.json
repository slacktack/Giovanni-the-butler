{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giovanni",
  "version": "1.0.1",
  "identifier": "com.tushargautam.giovanni",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "dmg": {
        "windowSize": { "width": 760, "height": 470 },
        "appPosition": { "x": 210, "y": 200 },
        "applicationFolderPosition": { "x": 560, "y": 200 }
      }
    },
    "externalBin": [
      "binaries/node"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
